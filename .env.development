# Backend base URL
VITE_API_BASE_URL=http://localhost:8080
# or if you use this name in your axios instance:
VITE_BACKEND_URL=http://localhost:8080

# Feature toggles
VITE_ENABLE_MOCK=false
VITE_USE_HTTPS=false

# App meta
VITE_APP_NAME=SE331 Demo
VITE_APP_VERSION=1.0.0

# Pagination & network
VITE_DEFAULT_PAGE_SIZE=10
VITE_TIMEOUT_MS=15000

# Auth paths (only override if different from backend defaults)
VITE_AUTH_LOGIN_PATH=/api/v1/auth/authenticate
VITE_AUTH_REFRESH_PATH=/api/v1/auth/refresh-token
VITE_AUTH_REGISTER_PATH=/api/v1/auth/register
VITE_AUTH_LOGOUT_PATH=/api/v1/auth/logout
